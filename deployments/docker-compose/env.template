# Server configuration for the docker-compose deployment (template, contains no secrets).
# Do not edit by hand on a new server: run ./gen-env.sh, which copies this to `.env` and fills in
# random secrets. RELEASE is written by install.sh from the bundle's RELEASE.txt.

RELEASE=

# ── Public address ────────────────────────────────────────────────────────────
# Plain HTTP on an IP:    SITE_ADDRESS=:80      WEB_URL=http://203.0.113.10
# Domain + Let's Encrypt: SITE_ADDRESS=projects.example.com   WEB_URL=https://projects.example.com
#   (ports 80 and 443 must be reachable; set CERT_EMAIL="email you@example.com")
SITE_ADDRESS=:80
WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# ── Secrets (generated) ───────────────────────────────────────────────────────
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=plane
POSTGRES_PASSWORD=
POSTGRES_DB=plane

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane

# ── MinIO (the access key / secret are the MinIO root credentials) ────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=
MINIO_ENDPOINT_SSL=0
MINIO_CONSOLE_PORT=9090
FILE_SIZE_LIMIT=5242880

# ── Application ───────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
MCP_SERVER_ENABLED=1
MCP_READ_ONLY=0
MCP_TOOLSETS=all
CYBERNETICS_DATA_ENABLED=1
CYBERNETICS_DATA_REQUIRE_HTTPS=1
CYBERNETICS_DATA_ALLOWED_IPS=
CYBERNETICS_DATA_ALLOWED_HOSTS=
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# Where compose finds init/ . The bundle keeps it next to the compose file.
INIT_DIR=./init
