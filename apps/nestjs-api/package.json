{
  "name": "nestjs-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + Mastra drop-in replacement for the Plane Django backend (apps/api)",
  "license": "AGPL-3.0",
  "author": "Plane Software Inc.",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:scheduler": "node dist/scheduler.js",
    "dev": "nest start --watch",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.e2e.spec.ts'",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^10.4.19",
    "@nestjs/core": "^10.0.5",
    "@nestjs/devtools-integration": "^0.2.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.19",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.1.2",
    "@scalar/nestjs-api-reference": "^1.0.13",
    "@sendgrid/mail": "^8.1.4",
    "@supercharge/request-ip": "^1.2.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "address": "^2.0.2",
    "amqplib": "^0.10.9",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.53.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.2",
    "fast-glob": "^3.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "mammoth": "^1.12.0",
    "minio": "^8.0.2",
    "multer": "^1.4.5-lts.1",
    "nestjs-pino": "^4.0.0",
    "node-redisson": "^1.0.3",
    "passport": "^0.7.0",
