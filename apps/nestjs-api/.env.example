# --- Shared with Django (apps/api) — MUST match for drop-in compatibility ---
# SECRET_KEY is load-bearing: it signs Django sessions AND derives the Fernet key for
# InstanceConfiguration secrets. It MUST be identical to the Django backend's SECRET_KEY.
SECRET_KEY=

# --- Database (same Postgres as Django) ---
DATABASE_URL=postgresql://plane:plane@localhost:5432/plane
# Optional read replica
DATABASE_READ_REPLICA_URL=

# --- Redis (cache / OTP / throttle / locks) ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (Celery-compatible broker) ---
AMQP_URL=amqp://guest:guest@localhost:5672/
# Queue this worker consumes (use a dedicated queue during migration, e.g. celery.node)
NODE_CELERY_QUEUE=celery
CELERY_PREFETCH=4

# --- HTTP server ---
PORT=8000

# --- Sessions / cookies (match Django settings) ---
SESSION_COOKIE_NAME=session-id
ADMIN_SESSION_COOKIE_NAME=admin-session-id
SESSION_COOKIE_AGE=604800
ADMIN_SESSION_COOKIE_AGE=3600
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax

# --- Rate limiting ---
API_KEY_RATE_LIMIT=60/minute

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- Config source (mirror Django get_configuration_value) ---
# "1" => read InstanceConfiguration from DB; "0" => read from environment
SKIP_ENV_VAR=1

# --- AI (Mastra) ---
# Mode A (default drop-in): route via an OpenAI-compatible gateway (LiteLLM)
LLM_GATEWAY_URL=
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
UNSPLASH_ACCESS_KEY=

# --- Live collaboration service ---
LIVE_BASE_URL=http://localhost:3100
LIVE_BASE_PATH=/live/

# --- Storage (S3 / MinIO) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_S3_ENDPOINT_URL=
USE_MINIO=0
FILE_SIZE_LIMIT=5242880

# --- Retention / periodic ---
HARD_DELETE_AFTER_DAYS=60
METRICS_PUSH_INTERVAL_MINUTES=360

# --- DB bootstrap (db:init CLI + seed-on-boot hook) ---
SEED_ON_BOOT=1
INSTANCE_ADMIN_EMAIL=
INSTANCE_ADMIN_PASSWORD=
INSTANCE_ADMIN_FIRST_NAME=
INSTANCE_ADMIN_LAST_NAME=
INSTANCE_ADMIN_COMPANY=Plane Community Edition
INSTANCE_ADMIN_TELEMETRY=1
